# Copy to .env and adjust
PRODUCTS_API_URL=https://aba-craft.vercel.app/api/products
# PRODUCTS_API_KEY=your-backend-token-if-required
CATALOG_REFRESH_SECONDS=300

INTENT_CONFIDENCE_THRESHOLD=0.35
PRODUCT_MATCH_THRESHOLD=75
SEMANTIC_MATCH_THRESHOLD=0.15
MEMORY_TTL_SECONDS=1800
MAX_PRODUCTS_IN_LIST=5

STORE_NAME=Aba Craft
# Set this and the automation workflow must send header: X-API-Key: <value>
# SERVICE_API_KEY=change-me
